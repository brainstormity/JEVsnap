{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "dist/renderer",
    "rootDir": "src/renderer",
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/renderer/**/*.ts"
  ]
}
