{
  "name": "jevsnap-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "JEVsnap for Linux and Windows: screenshot hotkey that automatically blacks out secrets and personal info.",
  "license": "MIT",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "test": "npm run build && tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist": "npm run build && electron-builder",
    "smoke": "npm run build && electron . --no-sandbox",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "author": {
    "name": "JEVsnap contributors"
  },
  "homepage": "https://github.com/brainstormity/JEVsnap",
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "dev.jevsnap.desktop",
    "productName": "JEVsnap",
    "copyright": "MIT License",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map",
      "!**/node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!**/node_modules/@tesseract.js-data/eng/4.0.0_best_int/*.gz.*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "JEVsnap contributors <jevsnap@users.noreply.github.com>",
      "synopsis": "Screenshot hotkey that automatically hides secrets and personal info",
      "desktop": {
        "entry": {
          "Comment": "Redact screenshots automatically",
          "Keywords": "screenshot;redact;privacy;"
        }
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
